{
  "name": "plan-b-crm",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "tsx server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.mjs && esbuild server/runtime.ts --bundle --platform=node --format=esm --packages=external --outfile=build/runtime.mjs && esbuild server/drill-worker.ts --bundle --platform=node --format=esm --packages=external --outfile=build/drill.mjs",
    "start": "node --env-file-if-exists=.env.local build/server.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "package:demo": "tsx scripts/package-demo.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "archiver": "^7.0.1",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.5"
  }
}
